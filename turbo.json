{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "check": {
      "dependsOn": [],
      "cache": false,
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@oim-dev/relay-server#build": {
      "dependsOn": ["^build", "@relay/web#build"],
      "outputs": ["dist/**"]
    },
    "@oim-dev/relay-cli#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "RELAY_CONFIG",
        "RELAY_ACTOR",
        "RELAY_PORT",
        "RELAY_API_URL",
        "RELAY_WEB_PORT"
      ]
    },
    "@oim-dev/relay-cli#dev": {
      "cache": false,
      "persistent": false,
      "passThroughEnv": [
        "RELAY_CONFIG",
        "RELAY_ACTOR",
        "RELAY_SERVER_URL",
        "NO_COLOR",
        "FORCE_COLOR",
        "TERM"
      ]
    },
    "start": {
      "dependsOn": ["build", "@relay/web#build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["RELAY_CONFIG", "RELAY_ACTOR", "RELAY_PORT", "RELAY_WEB_PORT"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@oim-dev/relay-cli#test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/skills/relay/**",
        "$TURBO_ROOT$/packages/dev-agents/src/**",
        "$TURBO_ROOT$/packages/dev-agents/README.md",
        "$TURBO_ROOT$/packages/relay-skill/README.md",
        "$TURBO_ROOT$/scripts/release/**"
      ],
      "outputs": []
    },
    "@relay/core#test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/src/**",
        "$TURBO_ROOT$/apps/web/src/**",
        "$TURBO_ROOT$/packages/contracts/src/**",
        "$TURBO_ROOT$/packages/server-runtime/src/**",
        "$TURBO_ROOT$/packages/project-runtime/src/**",
        "$TURBO_ROOT$/apps/mcp/src/**"
      ],
      "outputs": []
    },
    "@oim-dev/relay-mcp#test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/release/**"],
      "outputs": []
    },
    "@oim-dev/relay-mcp#start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["RELAY_CONFIG", "RELAY_MCP_PORT", "RELAY_SERVER_URL"]
    },
    "@oim-dev/relay-server#test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/apps/cli/package.json",
        "$TURBO_ROOT$/apps/cli/scripts/clean.mjs",
        "$TURBO_ROOT$/apps/web/package.json",
        "$TURBO_ROOT$/packages/rest-sdk/**"
      ],
      "outputs": []
    },
    "package:check": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "npm_execpath",
        "npm_config_*",
        "NPM_CONFIG_*",
        "NODE_EXTRA_CA_CERTS",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "no_proxy",
        "RELEASE_TAG"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
