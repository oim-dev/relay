{
  "name": "@relay/server-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "tasks-source": "./src/bootstrap.ts",
      "types": "./dist/bootstrap.d.ts",
      "default": "./dist/bootstrap.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "clean": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.1",
    "@relay/contracts": "workspace:*",
    "@relay/core": "workspace:*",
    "@relay/project-runtime": "workspace:*",
    "fastify": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@relay/rest-sdk": "workspace:*",
    "@relay/typescript-config": "workspace:*",
    "@types/node": "^22.18.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
