{
  "name": "@relay/project-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "tasks-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "clean": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:git-storage": "node --conditions=tasks-source --import tsx --experimental-test-coverage \"--test-coverage-include=**/git-storage/*.ts\" \"--test-coverage-include=**/storage/access.ts\" \"--test-coverage-include=**/storage/snapshot.ts\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 --test test/git-storage.test.ts test/git-worktree.test.ts test/git-template.test.ts"
  },
  "dependencies": {
    "@relay/contracts": "workspace:*",
    "@relay/core": "workspace:*",
    "@relay/rest-sdk": "workspace:*",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@relay/typescript-config": "workspace:*",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
