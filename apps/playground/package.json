{
  "name": "@relay/playground",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "init": "node init.mjs",
    "cli": "tsx --tsconfig ../cli/tsconfig.dev.json --conditions=tasks-source ../cli/src/main.ts --config relay.workspace.json",
    "tasks": "pnpm --silent run cli",
    "mcp": "tsx --conditions=tasks-source ../mcp/src/main.ts --config relay.workspace.json"
  },
  "devDependencies": {
    "@oim-dev/relay-cli": "workspace:*",
    "tsx": "^4.20.5"
  }
}
