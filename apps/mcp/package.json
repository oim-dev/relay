{
  "name": "@oim-dev/relay-mcp",
  "version": "0.9.2",
  "description": "Relay MCP: продукт, задачи досок, сущности и контекст для AI-агентов",
  "type": "module",
  "imports": {
    "#manifest": "./package.json"
  },
  "bin": {
    "relay-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oim-dev/relay.git",
    "directory": "apps/mcp"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "clean": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --import tsx --test test/*.test.ts",
    "package:check": "node ../../scripts/package.mjs mcp",
    "prepack": "node -e \"throw new Error('Выполните pnpm run package:check:mcp из корня репозитория; публикуйте проверенный архив.')\""
  },
  "dependencies": {
    "@relay/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@relay/core": "workspace:*",
    "@relay/project-runtime": "workspace:*",
    "@relay/rest-sdk": "workspace:*",
    "commander": "^14.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@relay/server-runtime": "workspace:*",
    "@relay/typescript-config": "workspace:*",
    "@types/node": "^22.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
